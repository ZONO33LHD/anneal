# Anneal configuration.
# Leave any of these empty to use the built-in mock provider for that capability.
# When a key is present, Anneal automatically switches to the real implementation.

# --- LLM (Google Gemini) ---
# Default model is the cheapest tier per the spec (6.1).
GEMINI_API_KEY=
ANNEAL_LLM_MODEL=gemini-2.5-flash-lite

# --- GitHub ---
# Fine-grained PAT or classic token with repo scope.
GITHUB_TOKEN=

# --- Slack ---
# Incoming webhook URL. Empty => notifications are printed to the console.
SLACK_WEBHOOK_URL=

# --- Storage ---
# Path to the local JSON store that acts as the single source of truth (NF-022).
ANNEAL_STORE_PATH=.anneal/store.json

# --- Behaviour thresholds (14章) ---
# Self-improvement triggers when the rolling average of the last N evaluations drops.
ANNEAL_IMPROVE_WINDOW=5
ANNEAL_LOW_SCORE_THRESHOLD=70
