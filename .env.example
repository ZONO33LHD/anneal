# Anneal configuration.
# Leave any value empty to use the built-in mock for that capability.
# When a key is present, Anneal switches to the real implementation.

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=
ANNEAL_LLM_MODEL=gemini-2.5-flash-lite

# --- GitHub ---
GITHUB_TOKEN=
# Optional read-only token for remote scan (Contents API). Falls back to GITHUB_TOKEN.
# Use a least-privilege (contents:read) token to scan private repos.
ANNEAL_CONTENTS_TOKEN=

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- Storage ---
ANNEAL_STORE_PATH=.anneal/store.json

# --- HTTP internal tasks ---
# POST /internal/scan and /internal/tick require this token in X-Anneal-Internal-Token.
ANNEAL_INTERNAL_TOKEN=
# Or accept Google OIDC bearer tokens, usually from Cloud Scheduler.
ANNEAL_INTERNAL_OIDC_AUDIENCE=
ANNEAL_INTERNAL_OIDC_EMAIL=
# Comma-separated scan targets. Use /path/to/repo or /path/to/repo=owner/repo.
ANNEAL_SCAN_TARGETS=

# --- Behaviour thresholds ---
ANNEAL_IMPROVE_WINDOW=5
ANNEAL_LOW_SCORE_THRESHOLD=70

# --- Logging (slog) ---
# ANNEAL_LOG_FORMAT: "text"（既定, ローカル向け）/ "json"（Cloud Run 等で severity 付き）
ANNEAL_LOG_FORMAT=text
# ANNEAL_DEBUG=1 で Debug レベルを有効化
ANNEAL_DEBUG=
