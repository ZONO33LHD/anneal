{
  "name": "anneal",
  "version": "0.1.0",
  "description": "Self-improving dependency & security update agent. Refine your dependencies. Refine yourself.",
  "type": "module",
  "bin": {
    "anneal": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "anneal": "tsx src/index.ts",
    "demo": "tsx src/index.ts demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dependencies",
    "security",
    "devsecops",
    "agent",
    "llm",
    "self-improving"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@google/genai": "^0.3.0",
    "@octokit/rest": "^21.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@vitest/coverage-v8": "^2.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
